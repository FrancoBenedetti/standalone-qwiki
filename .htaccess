# Protect configuration and user data stores from direct web access
<FilesMatch "\.(json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent script execution in uploads directory
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
Options -ExecCGI
